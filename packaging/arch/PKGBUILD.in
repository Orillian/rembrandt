# Maintainer: Rembrandt contributors <https://github.com/thesnarkitecht/rembrandt>
# Generated for each release by .github/workflows/release.yml and attached to the GitHub release;
# used by the one-line installer on Arch and Omarchy.
pkgname=rembrandt
pkgver=@VERSION@
pkgrel=1
pkgdesc="Free photo editor for RAW and JPEG with on-device AI"
arch=('x86_64')
url="https://github.com/thesnarkitecht/rembrandt"
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'openssl' 'hicolor-icon-theme')
optdepends=('xdg-utils: open links in your browser')
options=('!strip' '!debug')
source=("rembrandt.deb")
sha256sums=('@SHA256@')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
  # Standard permissions whatever the .deb carried: folders and the app 755, everything else 644
  # (restrictive ones there broke the icon and desktop entry for some users).
  find "$pkgdir" -type d -exec chmod 755 {} +
  find "$pkgdir/usr/share" -type f -exec chmod 644 {} +
  chmod 755 "$pkgdir"/usr/bin/* 2>/dev/null || true
  install -Dm644 "$pkgdir/usr/share/doc/rembrandt/copyright" "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
